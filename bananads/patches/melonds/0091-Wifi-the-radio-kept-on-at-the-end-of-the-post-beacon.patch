+    diag::IRQ13State(IOPORT(W_ModeWEP), IOPORT(W_PowerTX), IOPORT(W_PowerDownCtrl), IsMP, IsMPClient,
+                     (u8*)&IOPORT(W_BSSID0), apassoc, autosleep && !(IOPORT(W_PowerTX) & (1<<1)));
+    if (autosleep)
     {
         if (!(IOPORT(W_PowerTX) & (1<<1)))
         {

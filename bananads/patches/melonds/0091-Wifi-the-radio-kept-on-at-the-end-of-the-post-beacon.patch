     return (*(u32*)&a[0] == 0xFFFFFFFF) && (*(u16*)&a[4] == 0xFFFF);
 }
 
+// BananaDS diagnostics: Debug level (BananaDS log.level 0), "[diag]" prefix, each category at most N lines a second
+// (the lines held back are counted and reported with the category's next line)
+namespace diag
+{
+struct Rate { u64 Start; int N; int Held; };
+static Rate RTxMgmt, RTxMP, RTxData, RTxBeacon, RTxNoChan, RRxMgmt, RRxMP, RRxData, RRxDrop, RRxOk, RCom, RHostGone;
+
+static bool Allow(Rate& r, int max, const char* cat)
+{
+    u64 now = Platform::GetMSCount();
+    if (r.Start == 0 || (now - r.Start) >= 1000)
+    {
+        if (r.Held)
+            Log(LogLevel::Debug, "[diag] (%s: %d more lines not shown in the last second)\n", cat, r.Held);
+        r.Start = now; r.N = 0; r.Held = 0;
+    }
+    if (r.N < max) { r.N++; return true; }
+    r.Held++;
+    return false;
+}
+
+static const u8 kCmd[6]   = {0x03, 0x09, 0xBF, 0x00, 0x00, 0x00};
+static const u8 kReply[6] = {0x03, 0x09, 0xBF, 0x00, 0x00, 0x10};
+static const u8 kAck[6]   = {0x03, 0x09, 0xBF, 0x00, 0x00, 0x03};
+
+struct MacStr { char S[18]; };
+static MacStr Mac(const u8* m)
+{
+    MacStr r;
+    snprintf(r.S, sizeof(r.S), "%02X:%02X:%02X:%02X:%02X:%02X", m[0], m[1], m[2], m[3], m[4], m[5]);
+    return r;
+}
+
+// 0 management (not beacon), 1 MP CMD/REPLY/ACK, 2 data/control, 3 beacon
+static int Class(const u8* h)
+{
+    if (MACEqual(&h[4], kCmd) || MACEqual(&h[16], kReply) || MACEqual(&h[4], kReply) || MACEqual(&h[4], kAck))
+        return 1;
+    u16 fc = *(const u16*)h;
+    if (((fc >> 2) & 3) == 0) return (((fc >> 4) & 0xF) == 8) ? 3 : 0;
+    return 2;
+}
+
+static const char* Kind(const u8* h)
+{
+    if (MACEqual(&h[4], kCmd)) return "MP-CMD";
+    if (MACEqual(&h[16], kReply) || MACEqual(&h[4], kReply)) return "MP-REPLY";
+    if (MACEqual(&h[4], kAck)) return "MP-ACK";
+    u16 fc = *(const u16*)h;
+    u16 type = (fc >> 2) & 3, sub = (fc >> 4) & 0xF;
+    static const char* mgmt[16] = {"assoc-req", "assoc-resp", "reassoc-req", "reassoc-resp", "probe-req",
+        "probe-resp", "mgmt-6", "mgmt-7", "beacon", "ATIM", "disassoc", "auth", "deauth", "action", "mgmt-14", "mgmt-15"};
+    if (type == 0) return mgmt[sub];
+    if (type == 1) return "ctrl";
+    if (type == 2) return "data";
+    return "type-3";
+}
+
+// buf: a frame with melonDS's 12-byte TX/RX header in front of the 802.11 header; len: buf's length
+static void Frame(const char* dir, Rate* rates, const u8* buf, int len, const char* note, u64 ts)
+{
+    if (len < 12 + 24) return;
+    const u8* h = &buf[12];
+    int c = Class(h);
+    static const int max[4] = {60, 10, 10, 2};
+    static const char* cat[4] = {"mgmt", "MP", "data", "beacon"};
+    char label[24];
+    snprintf(label, sizeof(label), "%s %s", dir, cat[c]);
+    if (!Allow(rates[c], max[c], label)) return;
+
+    char extra[64] = "";
+    u16 fc = *(const u16*)h;
+    u16 sub = (fc >> 4) & 0xF;
+    int bodylen = len - 12 - 24;
+    if (c == 0 && sub == 0xB && bodylen >= 6)       // auth: algorithm, sequence, status
+        snprintf(extra, sizeof(extra), " auth alg=%d seq=%d status=%d", *(const u16*)&h[24], *(const u16*)&h[26], *(const u16*)&h[28]);
+    else if (c == 0 && (sub == 0x1 || sub == 0x3) && bodylen >= 6)  // assoc resp: capability, status, AID
+        snprintf(extra, sizeof(extra), " cap=%04X status=%d aid=%04X", *(const u16*)&h[24], *(const u16*)&h[26], *(const u16*)&h[28]);
+    else if (c == 0 && (sub == 0x0 || sub == 0x2) && bodylen >= 4)  // assoc req: capability, listen interval
+        snprintf(extra, sizeof(extra), " cap=%04X listen=%d", *(const u16*)&h[24], *(const u16*)&h[26]);
+    else if (c == 0 && (sub == 0xA || sub == 0xC) && bodylen >= 2)  // disassoc/deauth: reason
+        snprintf(extra, sizeof(extra), " reason=%d", *(const u16*)&h[24]);
+    else if (c == 1 && MACEqual(&h[4], kCmd) && bodylen >= 4)
+        snprintf(extra, sizeof(extra), " clienttime=%d clientmask=%04X", *(const u16*)&h[24], *(const u16*)&h[26]);
+
+    Log(LogLevel::Debug, "[diag] %s %s fc=%04X dst=%s src=%s a3=%s seq=%d ch=%d rate=%02X len=%d ts=%llu%s%s%s\n",
+        dir, Kind(h), fc, Mac(&h[4]).S, Mac(&h[10]).S, Mac(&h[16]).S, (*(const u16*)&h[22]) >> 4,
+        buf[9], buf[8], len, (unsigned long long)ts, extra, note ? " " : "", note ? note : "");
+}
+
+static Rate TxRates[4], RxRates[4];
+
+static void IRQ13State(u16 modewep, u16 powertx, u16 powerdownctrl, bool ismp, bool ismpclient, const u8* bssid,
+                       bool apassoc, bool powerdown)
+{
+    static u64 last = ~0ULL;
+    u64 cur = (modewep & 0x7F) | ((powertx & 3) << 8) | ((powerdownctrl & 3) << 12) | (powerdown ? (1 << 16) : 0)
+            | (ismp ? (1 << 17) : 0) | (ismpclient ? (1 << 18) : 0)
+            | ((u64)bssid[3] << 24) | ((u64)bssid[4] << 32) | ((u64)bssid[5] << 40) | ((u64)bssid[0] << 48);
+    if (cur == last) return;
+    last = cur;
+    const int mode = modewep & 7;
+    const bool sleepon = !(powertx & 2);
+    // what the power-down request then does: W_POWERDOWNCTRL bit0 inhibits it (UpdatePowerStatus)
+    const char* effect = !powerdown ? "stays on" : ((powerdownctrl & 1) ? "power-down requested, inhibited by PowerDownCtrl bit0" : "auto power-down");
+    Log(LogLevel::Debug, "[diag] IRQ13: ModeWEP=%04X (mode %d) PowerTX=%d PowerDownCtrl=%d IsMP=%d IsMPClient=%d (%s) BSSID=%s%s -> %s"
+        " (D rule; 1.1 would %s, 906e9eb would %s)\n",
+        modewep, mode, powertx & 3, powerdownctrl & 3, ismp, ismpclient,
+        (ismp && !ismpclient) ? "MP host" : (ismpclient ? "MP client" : "not in MP"),
+        Mac(bssid).S, apassoc ? " (melonAP)" : "", effect,
+        ((mode != 3) && sleepon) ? "request power-down" : "stay on",
+        ((mode == 0) && sleepon) ? "request power-down" : "stay on");
+}
+}

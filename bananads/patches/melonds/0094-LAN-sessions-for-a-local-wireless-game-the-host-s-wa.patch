+void LAN::SetDiscoveryTag(const char* gamecode, u8 flags)
+{
+    HasDiscoveryTag = gamecode != nullptr;
+    if (!gamecode) return;
+    memcpy(MyDiscoveryTag.GameCode, gamecode, 4);
+    MyDiscoveryTag.Flags = flags;
+    MyDiscoveryTag.Nonce = DiscoveryNonce;
+}
+
+bool LAN::ReadDiscoveryTag(const DiscoveryData& data, DiscoveryTag& tag)
+{
+    // the visible name has to end before the tag, and the tag has to be there
+    if (strnlen(data.SessionName, kDiscoveryTagOffset) >= (size_t)kDiscoveryTagOffset) return false;
+    const char* t = &data.SessionName[kDiscoveryTagOffset];
+    if (t[0] != 'B' || t[1] != 'D' || t[2] != 'S' || t[3] != 1) return false;
+    memcpy(tag.GameCode, &t[4], 4);
+    tag.Flags = (u8)t[8];
+    tag.Nonce = 0;
+    for (int i = 0; i < 4; i++) tag.Nonce |= (u32)(u8)t[10 + i] << (8 * i);
+    return true;
+}

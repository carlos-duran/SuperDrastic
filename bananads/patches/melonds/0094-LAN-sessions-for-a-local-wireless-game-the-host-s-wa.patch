+// RecvReplies: a MP-active player that doesn't reply to this many MP commands in a row (each one a full
+// MPRecvTimeout wait) is no longer waited for, until it sends us a reply or an auth/association request again
+const int kMPMaxMisses = 20;
+
+// BananaDS diagnostics: Debug level (BananaDS log.level 0), "[diag] LAN" prefix, rate-limited
+namespace landiag
+{
+struct Rate { u64 Start; int N; int Held; };
+static Rate RSend, RRecv, RGone;
+static int LastSender = -1;
+static u16 LastBitmask = 0xFFFF;
+// per-second counters, reported from Process()
+static u64 CountStart = 0;

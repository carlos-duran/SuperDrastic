+
+static bool Allow(Rate& r, int max, const char* cat)
+{
+    u64 now = Platform::GetMSCount();
+    if (r.Start == 0 || (now - r.Start) >= 1000)
+    {
+        if (r.Held)
+            Platform::Log(Platform::LogLevel::Debug, "[diag] LAN (%s: %d more lines not shown in the last second)\n", cat, r.Held);
+        r.Start = now; r.N = 0; r.Held = 0;
+    }
+    if (r.N < max) { r.N++; return true; }
+    r.Held++;
+    return false;
+}
+
+static bool MacIs(const u8* m, u8 last)
+{
+    return m[0] == 0x03 && m[1] == 0x09 && m[2] == 0xBF && m[3] == 0 && m[4] == 0 && m[5] == last;
+}
+
+// pkt: melonDS's 12-byte TX/RX header, then the 802.11 header; nullptr for beacons (not logged)
+static const char* Kind(const u8* pkt, int len)
+{
+    if (len < 12 + 24) return "short";
+    const u8* h = &pkt[12];
+    if (MacIs(&h[4], 0x00)) return "MP-CMD";
+    if (MacIs(&h[16], 0x10) || MacIs(&h[4], 0x10)) return "MP-REPLY";
+    if (MacIs(&h[4], 0x03)) return "MP-ACK";
+    u16 fc = h[0] | (h[1] << 8);
+    u16 type = (fc >> 2) & 3, sub = (fc >> 4) & 0xF;
+    static const char* mgmt[16] = {"assoc-req", "assoc-resp", "reassoc-req", "reassoc-resp", "probe-req",
+        "probe-resp", "mgmt-6", "mgmt-7", nullptr, "ATIM", "disassoc", "auth", "deauth", "action", "mgmt-14", "mgmt-15"};
+    if (type == 0) return mgmt[sub];
+    if (type == 1) return "ctrl";
+    if (type == 2) return "data";
+    return "type-3";
+}
+
+static void Packet(const char* dir, Rate& r, const u8* pkt, int len, int ret, u64 ts, int me, u16 connected, int sender)
+{
+    if (!pkt || len < 12 + 24) return;
+    const char* kind = Kind(pkt, len);
+    if (!kind) return; // beacon
+    if (!Allow(r, 30, dir)) return;
+    const u8* h = &pkt[12];
+    Platform::Log(Platform::LogLevel::Debug,
+        "[diag] LAN %s %s fc=%02X%02X dst=%02X:%02X:%02X:%02X:%02X:%02X src=%02X:%02X:%02X:%02X:%02X:%02X ch=%d len=%d ret=%d ts=%llu me=%d sender=%d connected=%04X\n",
+        dir, kind, h[1], h[0], h[4], h[5], h[6], h[7], h[8], h[9], h[10], h[11], h[12], h[13], h[14], h[15],
+        pkt[9], len, ret, (unsigned long long)ts, me, sender, connected);
+}
+}
